{
  "name": "chenguang-agent-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "晨光 Agent 平台前端框架（Vue3 + TS + Pinia + Vue-Router，严格分层：apis/services/router/store/pages/components）",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "axios-mock-adapter": "^2.1.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
